# Required: the tools exit with the setting's name if either is missing.
# Base URL of the Ollama server that embeds text.
OLLAMA_HOST=
# Embedding model name served by that Ollama (uses EmbeddingGemma-style prefixes).
RAG_EMBED_MODEL=

# Optional (defaults shown).
# Directory of *.md files to index.
RAG_CORPUS_DIR=sample-corpus
# Where the local Chroma store lives (machine-local disk only).
RAG_STORE_DIR=~/.local-rag-mcp/store
